# Public Supabase values for local Node tooling only (seed scripts, CLI).
# After `pnpm supabase:start`, run `pnpm exec supabase status` for the live keys.
#
# The Angular app does NOT read this file — it uses `src/environments/environment*.ts`
# (production file + development fileReplacements in angular.json).
#
# The service-role key must NEVER appear here, in Angular code, or in any bundled config.
# Put it only in your local `.env` when you need it for the Node seed script (`pnpm seed:auth`).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=  # local .env only — never commit
