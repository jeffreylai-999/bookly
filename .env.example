# Public Supabase values only. Copy to `.env` for local tooling (seed scripts, CLI).
# After `pnpm supabase:start`, run `pnpm exec supabase status` for the live keys.
#
# The service-role key must NEVER appear here, in Angular code, or in any bundled config.
# Put it only in your local `.env` when you need it for the Node seed script.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
